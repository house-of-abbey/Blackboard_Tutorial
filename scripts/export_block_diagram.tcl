package require json

set script_path   [file normalize [info script]]
set script_folder [file dirname   $script_path]
set script_file   [file tail      $script_path]

# Values that are static
# NB. This path is set to work when the script is sourced from the build directory.
set config_file   {../../scripts/config.json}
set device        {xc7z007sclg400-1}
set source_folder {../../src}

if {[current_project -quiet] < 1} {
  puts "Error - Open a project to export."
  return 1
} else {
  # Fetch values from config file which are likely to change more often than the rest
  # of this script.
  cd [get_property DIRECTORY [get_projects]]
  if {[file exist $config_file]} {
    set fp [open $config_file r]
    set products [::json::json2dict [read $fp]]
    close $fp
    set build_folder "../[dict get $products build_folder]"
  } else {
    puts "Error - Cannot find the configuration file '$config_file' ([file normalize [get_property DIRECTORY [get_projects]]/$config_file])."
    return 1
  }

  set block_diagram [get_files -filter {FILE_TYPE == "Block Designs"}]
  if {[llength $block_diagram] == 1} {
    open_bd_design $block_diagram
    set project_name       [get_projects]
    set block_diagram_name [current_bd_design]
    set tcl_file           [file normalize "$script_folder/$project_name/create_vivado_project.tcl"]
  } else {
    puts "Error - There should be exactly one block diagram for this export script."
    return 1
  }
}

puts "Script variables set as follows:"
puts "  script_path        = $script_path"
puts "  script_folder      = $script_folder"
puts "  script_file        = $script_file"
puts "  config_file        = $config_file ([file normalize $config_file])"
puts "  project_name       = $project_name (determined by this script, not $config_file)"
puts "  block_diagram_name = $block_diagram_name (determined by this script, not $config_file)"
puts "  device             = $device"
puts "  build_folder       = $build_folder ([file normalize $build_folder])"
puts "  source_folder      = $source_folder ([file normalize $source_folder])"
puts "  tcl_file           = $tcl_file"

source -notrace $script_folder/utilities.tcl

if {[llength [get_bd_designs]] < 1} {
  puts "Error - No block diagram open to export."
  return 1
} else {
  file mkdir $script_folder/$project_name
  # Add a level of directory so that source_folder has the correct number of ".."
  set source_folder_int [file normalize $script_folder/dummy/$source_folder]

  # Need to have a block diagram open
  #  -bd_folder {../test_bd}
  write_bd_tcl \
    -force \
    -bd_name $block_diagram_name \
    -include_layout \
    -keep_paths_as_is \
    $script_folder/$project_name/create_block_diagram.tcl

  if {[catch {
    write_bd_layout \
      -force \
      -format svg \
      -orientation portrait \
      $script_folder/$project_name/block_design.svg
  } errmsg]} {
    if {[info exists require_bd_layout] && $require_bd_layout} {
      return -code error "Failed to export block diagram SVG for '$project_name': $errmsg"
    }
    puts "Note - Failed to export block diagram SVG: $errmsg"
    puts "Note - Re-run the export in Vivado GUI mode if you need to refresh block_design.svg."
  } else {
    # Ensure consistent colors
    set fp [open $script_folder/$project_name/block_design.svg r]
    set svg_text [read $fp]
    close $fp

    set new_svg_text [string map [list \
      {fill="white"}      {fill="#21222b"} \
      {stroke="#102235"}  {stroke="#628d30"} \
      {fill="#edf6fe"}    {fill="#50306c"} \
      {stroke="#41619f"}  {stroke="#797f8e"} \
      {fill="#41619f"}    {fill="#797f8e"} \
      {fill="#ddd4d0"}    {fill="#f0f0f0"} \
      {stroke="black"}    {stroke="#f7f8f9"} \
      {fill="black"}      {fill="#f7f8f9"} \
    ] $svg_text]

    set fp [open $script_folder/$project_name/block_design.svg w]
    puts -nonewline $fp $new_svg_text
    close $fp
  }

  ## Get TCL to write out a TCL file

  # Write this lot out to a text file called "create_vivado_project.tcl"
  set tcl_fileh [open $tcl_file w]
  puts $tcl_fileh "#!/usr/bin/env -S vivado -mode batch -nojournal -nolog -notrace -s"
  puts $tcl_fileh "# Automatically generated by $script_file"
  puts $tcl_fileh "#"
  puts $tcl_fileh ""
  puts $tcl_fileh "package require json"
  puts $tcl_fileh ""
  puts $tcl_fileh "set script_path   \[file normalize \[info script\]\]"
  puts $tcl_fileh "set script_folder \[file dirname   \$script_path\]"
  puts $tcl_fileh "set script_file   \[file tail      \$script_path\]"
  if {$project_name != "empty_hw"} {
    # This is not the special case project
    puts $tcl_fileh "set project_name  {$project_name}"
  }
  puts $tcl_fileh "set build_folder  {$build_folder}"
  puts $tcl_fileh "set source_folder {$source_folder}"

  puts $tcl_fileh "cd \$script_folder"
  puts $tcl_fileh "set config_file $config_file"
  puts $tcl_fileh "if {\[file exist \$config_file\]} {"
  puts $tcl_fileh "  set fp \[open \$config_file r\]"
  puts $tcl_fileh "  set products \[::json::json2dict \[read \$fp\]\]"
  puts $tcl_fileh "  close \$fp"
  puts $tcl_fileh "  set build_folder \"../\[dict get \$products build_folder\]\""
  puts $tcl_fileh "} else {"
  puts $tcl_fileh "  puts \"Error - Cannot find the configuration file '\$config_file' (\[file normalize \[get_property DIRECTORY \[get_projects\]\]/\$config_file\]).\""
  puts $tcl_fileh "  return 1"
  puts $tcl_fileh "}"
  puts $tcl_fileh ""
  # The generation script is one folder deeper
  puts $tcl_fileh "if {\[file exists \$build_folder/\$project_name\]} {"
  puts $tcl_fileh "  error \"Existing Project\" \"Delete existing project first at \[file normalize \$build_folder/\$project_name\]\" 1"
  puts $tcl_fileh "} else {"

  # Create project
  puts $tcl_fileh "  create_project \$project_name \$build_folder/\$project_name -part $device"
  puts $tcl_fileh "  set_property TARGET_LANGUAGE VHDL \[current_project\]"

  # Add external files from Git by reference
  foreach f [get_files -of_objects [get_filesets sources_1] -filter "(IS_GENERATED == 0) && ((FILE_TYPE == VHDL) || (FILE_TYPE == {VHDL 2008}) || (FILE_TYPE == Verilog))"] {
    # Exclude any sources in the block diagram subdirectory, including the generated top level
    if {[string first "/bd/" $f] < 0} {
      if {[string first "ieee_proposed" $f] > 0} {
        # Custom handling
        if {[string first "fixed_float_types_c" $f] > 0} {
          puts $tcl_fileh "  add_files \"\$::env(XILINX_VIVADO)/ids_lite/ISE/vhdl/src/ieee_proposed/fixed_float_types_c.vhd\""
          puts $tcl_fileh "  set_property file_type {VHDL} \[get_files {fixed_float_types_c.vhd}\]"
          puts $tcl_fileh "  set_property library {ieee_proposed} \[get_files {fixed_float_types_c.vhd}\]"
        } elseif {[string first "fixed_pkg_c" $f] > 0} {
          puts $tcl_fileh "  add_files \"\$::env(XILINX_VIVADO)/ids_lite/ISE/vhdl/src/ieee_proposed/fixed_pkg_c.vhd\""
          puts $tcl_fileh "  set_property file_type {VHDL} \[get_files {fixed_pkg_c.vhd}\]"
          puts $tcl_fileh "  set_property library {ieee_proposed} \[get_files {fixed_pkg_c.vhd}\]"
        } elseif {[string first "float_pkg_c" $f] > 0} {
          puts $tcl_fileh "  add_files \"\$::env(XILINX_VIVADO)/ids_lite/ISE/vhdl/src/ieee_proposed/float_pkg_c.vhd\""
          puts $tcl_fileh "  set_property file_type {VHDL} \[get_files {float_pkg_c.vhd}\]"
          puts $tcl_fileh "  set_property library {ieee_proposed} \[get_files {float_pkg_c.vhd}\]"
        }
      } else {
        set frel [relTo [file normalize $f] $source_folder_int]
        puts $tcl_fileh "  add_files \$source_folder/$frel"
        puts $tcl_fileh "  set_property file_type {[get_property file_type $f]} \[get_files {[file tail \$source_folder/$frel]}\]"
        puts $tcl_fileh "  set_property library {[get_property library $f]} \[get_files {[file tail \$source_folder/$frel]}\]"
      }
    }
  }

  foreach f [get_files -of_objects [get_filesets constrs_1]] {
    set frel [relTo [file normalize $f] $source_folder_int]
    puts $tcl_fileh "  add_files -fileset constrs_1 \$source_folder/$frel"
    puts $tcl_fileh "  set_property USED_IN_SYNTHESIS [get_property USED_IN_SYNTHESIS $f] \[get_files \$source_folder/$frel\]"
    puts $tcl_fileh "  set_property USED_IN_IMPLEMENTATION [get_property USED_IN_IMPLEMENTATION $f] \[get_files \$source_folder/$frel\]"
  }

  foreach f [get_files -of_objects [get_filesets sim_1]] {
    set frel [relTo [file normalize $f] $source_folder_int]
    puts $tcl_fileh "  add_files -fileset sim_1 \$source_folder/$frel"
    if {([get_property FILE_TYPE $f] == "VHDL") || ([get_property FILE_TYPE $f] == "VHDL 2008") || ([get_property FILE_TYPE $f] == "Verilog")} {
      puts $tcl_fileh "  set_property FILE_TYPE {[get_property FILE_TYPE $f]} \[get_files {[file tail \$source_folder/$frel]}\]"
      puts $tcl_fileh "  set_property USED_IN_SYNTHESIS [get_property USED_IN_SYNTHESIS $f] \[get_files \$source_folder/$frel\]"
      puts $tcl_fileh "  set_property LIBRARY [get_property LIBRARY $f] \[get_files \$source_folder/$frel\]"
    }
    puts $tcl_fileh "  set_property USED_IN_SIMULATION [get_property USED_IN_SIMULATION $f] \[get_files \$source_folder/$frel\]"
  }
  # Which simulation is selected by default
  puts $tcl_fileh "  set_property TOP [get_property TOP [get_filesets sim_1]] \[get_filesets sim_1\]"

  set tcf [get_property TARGET_CONSTRS_FILE [current_fileset -constrset]]
  set tcfr [relTo $tcf $source_folder_int]
  # Catch the case of no TARGET_CONSTRS_FILE
  if {[llength $tcf] > 0} {
    puts $tcl_fileh "  set_property TARGET_CONSTRS_FILE \$source_folder/$tcfr \[current_fileset -constrset\]"
  }

  # IP Repositories
  set ipr [get_property IP_REPO_PATHS [current_project]]
  if {[llength $ipr] > 0} {
    set iprr {}
    foreach d $ipr {
      lappend iprr [relTo $d $source_folder_int]
    }
    puts $tcl_fileh "  set_property IP_REPO_PATHS \[list \$source_folder/$iprr\] \[current_project\]"
    puts $tcl_fileh "  update_ip_catalog"
  }

  puts $tcl_fileh "  cd \$build_folder/\$project_name"
  # Generate the block diagram exported above
  puts $tcl_fileh "  # Override the default origin_dir in create_block_diagram.tcl"
  puts $tcl_fileh "  set origin_dir_loc ../build"
  # The generated script runs one directory level deeper than this one.
  puts $tcl_fileh "  source -notrace \$script_folder/create_block_diagram.tcl"
  puts $tcl_fileh "  make_wrapper -files \[get_files ${block_diagram_name}.bd\] -top -add"
  puts $tcl_fileh "  set_property TOP ${block_diagram_name}_wrapper \[current_fileset\]"
  puts $tcl_fileh "}"
  close $tcl_fileh
}

puts "Block diagram design exported to '$tcl_file'."
