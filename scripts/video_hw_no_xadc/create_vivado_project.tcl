#!/usr/bin/env -S vivado -mode batch -nojournal -nolog -notrace -s
# Automatically generated by export_block_diagram.tcl
#

package require json

set script_path   [file normalize [info script]]
set script_folder [file dirname   $script_path]
set script_file   [file tail      $script_path]
set project_name  {video_hw}
set build_folder  {../../build}
set source_folder {../../src}
cd $script_folder
set config_file ../../scripts/config.json
if {[file exist $config_file]} {
  set fp [open $config_file r]
  set products [::json::json2dict [read $fp]]
  close $fp
  set build_folder "../[dict get $products build_folder]"
} else {
  puts "Error - Cannot find the configuration file '$config_file' ([file normalize [get_property DIRECTORY [get_projects]]/$config_file])."
  return 1
}

if {[file exists $build_folder/$project_name]} {
  error "Existing Project" "Delete existing project first at [file normalize $build_folder/$project_name]" 1
} else {
  create_project $project_name $build_folder/$project_name -part xc7z007sclg400-1
  set_property TARGET_LANGUAGE VHDL [current_project]
  add_files -fileset constrs_1 $source_folder/constraints/managed.xdc
  set_property USED_IN_SYNTHESIS 1 [get_files $source_folder/constraints/managed.xdc]
  set_property USED_IN_IMPLEMENTATION 1 [get_files $source_folder/constraints/managed.xdc]
  add_files -fileset constrs_1 $source_folder/constraints/system.tcl
  set_property USED_IN_SYNTHESIS 1 [get_files $source_folder/constraints/system.tcl]
  set_property USED_IN_IMPLEMENTATION 1 [get_files $source_folder/constraints/system.tcl]
  set_property TOP system_wrapper [get_filesets sim_1]
  set_property TARGET_CONSTRS_FILE $source_folder/constraints/managed.xdc [current_fileset -constrset]
  set_property IP_REPO_PATHS [list $source_folder/../libs/VivadoIP] [current_project]
  update_ip_catalog
  cd $build_folder/$project_name
  # Override the default origin_dir in create_block_diagram.tcl
  set origin_dir_loc ../build
  source -notrace $script_folder/create_block_diagram.tcl
  make_wrapper -files [get_files system.bd] -top -add
  set_property TOP system_wrapper [current_fileset]
}
