      <ZoomEndTime time="5,550.001 ns"></ZoomEndTime>
      <Cursor1Time time="12.755 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="221"></NameColumnWidth>
      <ValueColumnWidth column_width="222"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="10" />
   <wvobject fp_name="/test_sevseg/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/test_sevseg/reset" type="logic">
      <obj_property name="ElementShortName">reset</obj_property>
      <obj_property name="ObjectShortName">reset</obj_property>
   </wvobject>
   <wvobject fp_name="/test_sevseg/dut/div_cnt" type="other">
      <obj_property name="ElementShortName">div_cnt</obj_property>
      <obj_property name="ObjectShortName">div_cnt</obj_property>
   </wvobject>
   <wvobject fp_name="/test_sevseg/enable" type="logic">
      <obj_property name="ElementShortName">enable</obj_property>
      <obj_property name="ObjectShortName">enable</obj_property>
   </wvobject>
   <wvobject fp_name="/test_sevseg/mode" type="logic">
      <obj_property name="ElementShortName">mode</obj_property>
      <obj_property name="ObjectShortName">mode</obj_property>
   </wvobject>
   <wvobject fp_name="/test_sevseg/digits" type="array">
